# How the research-vm fleet runs this project. Read by research-vm-infra's
# bootstrap/wrapper/worker at boot; see that repo's templates/rvm.env for
# the full set of keys and their defaults.

# 3.11, matching .github/workflows/ci.yml. This is not cosmetic: the tier-0
# metric-hash gate normalizes source through ast.dump, whose output differs
# between 3.11 and 3.12, so tests/unit/test_metric_hash.py fails on a clean
# tree under 3.12 while CI is green. The instance must run what CI runs.
RVM_PYTHON="3.11"

RVM_ENV_INSTALL="pip install -e '.[dev]'"
RVM_ENV_FILES="pyproject.toml"

RVM_PROMPT_FILE="infra/prompt.md"
RVM_BRANCH="main"
RVM_CI_GATE=1

# Sweeps: run_sweep.py shards by --shard i/N, so the worker command is the
# same for every cell and the manifest only has to say how many there are.
# A manifest entry may override this per worker with its own "cmd".
RVM_WORKER_CMD="python scripts/run_sweep.py --arm QK --shard {worker_id}/{n_workers}"

RVM_INSTANCE_TYPE="t4g.small"
RVM_HARD_CAP_HOURS=4
RVM_WORKER_HOURS=3

# Pythia checkpoint revisions are large, slow to fetch, and shared with any
# other project probing the same model — hence a shared cache name rather
# than a per-project one. Seed it with:
#   rvm cache push huggingface ~/.cache/huggingface
RVM_CACHE_PATHS="huggingface:/home/ubuntu/.cache/huggingface"
